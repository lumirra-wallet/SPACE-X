{
  "installCommand": "corepack enable && corepack prepare pnpm@11.0.9 --activate && pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/spacex-platform run build",
  "outputDirectory": "artifacts/spacex-platform/dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://space-production-a4d8.up.railway.app/api/:path*"
    },
    {
      "source": "/ws",
      "destination": "https://space-production-a4d8.up.railway.app/ws"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
